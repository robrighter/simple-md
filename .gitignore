# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
src-tauri/Cargo.lock.bak

# Bundled sidecar binaries + dylibs (regenerated by `npm run ai:fetch-sidecar`).
# These are tens of MB per platform and shouldn't be tracked. The placeholder
# README inside the directory IS tracked so the directory itself remains.
src-tauri/binaries/llama-server-*
src-tauri/binaries/*.dylib
src-tauri/binaries/*.so
src-tauri/binaries/*.dll

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.*.local
